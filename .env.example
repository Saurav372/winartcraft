#--------------------------------------------------------------------
# WinArtCraft - CodeIgniter 4 Environment Configuration
#--------------------------------------------------------------------

CI_ENVIRONMENT = development

app.baseURL = 'http://localhost:8080/'
app.forceGlobalSecureRequests = false
app.CSPEnabled = false

# Database configuration is pre-configured in app/Config/Database.php 
# using SQLite3 at writable/database/winartcraft.db
